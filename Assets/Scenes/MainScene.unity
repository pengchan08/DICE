  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 48
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\U0001F3B2 Lucky Dice\uB294 \uB2E8\uC21C\uD55C \uB8F0\uACFC \uC9DC\uB9BF\uD55C
    \uC6B4, \uADF8\uB9AC\uACE0 \uC57D\uAC04\uC758\n \uC804\uB7B5\uC774 \uC5B4\uC6B0\uB7EC\uC9C4
    \uC8FC\uC0AC\uC704 \uAC8C\uC784\uC785\uB2C8\uB2E4!\r\n\r\n - \uAC01 \uB77C\uC6B4\uB4DC\uB294
    \uCD5C\uB300 8\uBC88 \uC8FC\uC0AC\uC704\uB97C \uAD74\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n
    - \uC6D0\uD558\uB294 \uC22B\uC790\uB294 \uB0A8\uAE30\uACE0, \uD544\uC694 \uC5C6\uB294
    \uC22B\uC790\uB294 \uC81C\uAC70\uD558\uC138\uC694.\n - \uB2E4\uC591\uD55C \uC870\uD569\uC744
    \uD1B5\uD574 \uB192\uC740 \uC810\uC218\uB97C \uB178\uB824\uBCF4\uC138\uC694.\n
    - \uC870\uD569\uC744 \uD074\uB9AD\uD574 \uC810\uC218\uB97C \uC5BB\uACE0 \uB2E4\uC74C
    \uB77C\uC6B4\uB4DC\uB85C \uB118\uC5B4\uAC00\uC138\uC694.\n - \uCD1D 3\uB77C\uC6B4\uB4DC
    \uB3D9\uC548 \uCD5C\uACE0\uC758 \uC810\uC218\uB97C \uAE30\uB85D\uD574\uBCF4\uC138\uC694.\n
    - \uB611\uAC19\uC740 \uC870\uD569\uC744 \uC5EC\uB7EC\uBC88 \uC0AC\uC6A9\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n <TIP!!>\n - Full House\uB098 Yacht\uCC98\uB7FC
    \uACE0\uB4DD\uC810 \uC870\uD569\uC740 \uAE30\uD68C\uB97C \uC798\n   \uB178\uB824\uBCF4\uC138\uC694.\n
    - \U0001F4A1\uB9E4 \uB77C\uC6B4\uB4DC\uB294 \uC0C8\uB85C\uC6B4 \uC804\uB7B5\uC774
    \uD544\uC694\uD569\uB2C8\uB2E4.\n - \uD604\uC7AC \uC810\uC218\uAC00 63\uC810
    \uC774\uC0C1\uC774\uBA74 \uCD94\uAC00 \uC810\uC218\uB97C \uC5BB\uC2B5\uB2C8\uB2E4.\n
    - \uC6B4\uB3C4 \uC911\uC694\uD558\uC9C0\uB9CC, \uC120\uD0DD\uC740 100% \uB2F9\uC2E0\uC758
    \uBAAB\uC785\uB2C8\uB2E4."
